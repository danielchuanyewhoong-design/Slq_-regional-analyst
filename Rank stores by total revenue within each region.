ELECT st.store_name, 
		r.region_name,
		SUM(sl.quantity * p.unit_price) AS revenue,
       RANK() OVER (PARTITION BY r.region_name 	
ORDER BY SUM(sl.quantity * p.unit_price) DESC) AS rank_in_region
FROM sales sl
JOIN stores st ON sl.store_id = st.store_id
JOIN regions r ON st.region_id = r.region_id
JOIN products p ON sl.product_id = p.product_id
GROUP BY st.store_name, r.region_name;
